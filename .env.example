# Supabase Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (Public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (PRIVATE - Never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Note: The frontend uses VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
# The service role key is only needed for server-side operations (not used in this project)
